#!/usr/bin/env bash
# pre-commit hook — invokes eval_before.py + verify_after.py gates
# per core-layer/governance-template.md "Verify-After"
# + docs/OPERATING_RULES.md (修改时需要评估，修改后需要验收).
#
# Per M-n 32 Guardrail #1 retrofitted (verify target state
# before commit).  Per M-n 35 critical-thinking primitive 3
# (pre-mortem): pre-commit check is cheap insurance against
# LLM-self-judgment.
#
# Non-blocking by default (prints warning, exits 0).  Set
# STRICT_EVAL=1 in env to convert warnings to FAIL.
#
# Per M-n 18 destruction: this hook is the FULL evaluation
# gate.  It runs BOTH eval_before.py (pre-staging check)
# AND prepare-commit-msg logic (commit message inspection
# after staging).

set -e

# Windows: python (native exe) cannot open MSYS paths (/c/...).
# Convert script path via cygpath when running under git-for-windows.
py() {
    local script="$1"; shift
    if command -v cygpath >/dev/null 2>&1; then
        script="$(cygpath -w "$script")"
    fi
    python "$script" "$@"
}

REPO_ROOT="$(git rev-parse --show-toplevel)"
EVAL_BEFORE="$REPO_ROOT/agent-tools/scripts/eval_before.py"
VERIFY_AFTER="$REPO_ROOT/agent-tools/scripts/verify_after.py"
SELF_HEALTH="$REPO_ROOT/agent-tools/scripts/self_health_check.py"
CROSS_REPO_AUDIT="$REPO_ROOT/agent-tools/scripts/cross_repo_audit.py"
P30_STATE="$REPO_ROOT/agent-tools/scripts/p30_acceptance.py"

echo "[pre-commit] Running eval_before gate..."

if [ -f "$EVAL_BEFORE" ]; then
    if py "$EVAL_BEFORE" --strict 2>&1; then
        echo "[pre-commit] eval_before: OK (regression evidence)"
    else
        rc=$?
        if [ "${STRICT_EVAL:-0}" = "1" ]; then
            echo "[pre-commit] eval_before: FAIL (strict mode)" >&2
            exit $rc
        fi
        echo "[pre-commit] eval_before: WARN (non-blocking, set STRICT_EVAL=1 for strict)"
    fi
else
    echo "[pre-commit] eval_before.py not found — skipping"
fi

# self_health_check.py: SUA self-audit per docs/OPERATING_RULES.md
# wordy-trap defense rule.
# Fail-open by default (advisory, exit 0). STRICT_EVAL=1 promotes
# to block. Pre-existing commits may have a body wordy-trap warning;
# that is informational, not a regression.
echo "[pre-commit] Running self_health_check audit..."
if [ -f "$SELF_HEALTH" ]; then
    if py "$SELF_HEALTH" 2>&1; then
        echo "[pre-commit] self_health_check: OK (regression evidence)"
    else
        sh_rc=$?
        if [ "${STRICT_EVAL:-0}" = "1" ]; then
            echo "[pre-commit] self_health_check: FAIL (strict mode)" >&2
            exit $sh_rc
        fi
        echo "[pre-commit] self_health_check: WARN (non-blocking, set STRICT_EVAL=1 for strict)"
    fi
else
    echo "[pre-commit] self_health_check.py not found — skipping"
fi

# cross_repo_audit.py: per docs/POST_SEARCH_EVALUATION_2026-07-30.md
# (Option C), audit sibling repos for mirror pollution before
# committing in upstream SUA. Fail-open by default; STRICT_EVAL=1
# promotes to block. Detects: missing adapter/ (Leaf-Only contract),
# mirror pollution (top-level core-layer/ / docs/ / hooks/ / src/),
# internal refs in AGENTS.md / README.md, branch-pinned submodules.
echo "[pre-commit] Running cross_repo_audit..."
if [ -f "$CROSS_REPO_AUDIT" ]; then
    if py "$CROSS_REPO_AUDIT" 2>&1; then
        echo "[pre-commit] cross_repo_audit: OK (regression evidence)"
    else
        cra_rc=$?
        if [ "${STRICT_EVAL:-0}" = "1" ]; then
            echo "[pre-commit] cross_repo_audit: FAIL (strict mode)" >&2
            exit $cra_rc
        fi
        echo "[pre-commit] cross_repo_audit: WARN (non-blocking, set STRICT_EVAL=1 for strict)"
    fi
else
    echo "[pre-commit] cross_repo_audit.py not found — skipping"
fi

# validate_links.py: per docs/PLANS/PLAN_2026-07-30.md + ATDD,
# validate all markdown cross-references (file + anchor) before
# commit. Catches broken refs before they ship. Fail-open by
# default; STRICT_EVAL=1 promotes to block. Per
# docs/BROKEN_REFS_AUDIT_2026-07-30.md, broken refs were a
# systemic issue caught only in audit (not pre-commit).
echo "[pre-commit] Running validate_links..."
VALIDATE_LINKS="$REPO_ROOT/agent-tools/scripts/validate_links.py"
if [ -f "$VALIDATE_LINKS" ]; then
    if py "$VALIDATE_LINKS" 2>&1; then
        echo "[pre-commit] validate_links: OK (regression evidence)"
    else
        vl_rc=$?
        if [ "${STRICT_EVAL:-0}" = "1" ]; then
            echo "[pre-commit] validate_links: FAIL (strict mode)" >&2
            exit $vl_rc
        fi
        echo "[pre-commit] validate_links: WARN (non-blocking, set STRICT_EVAL=1 for strict)"
    fi
else
    echo "[pre-commit] validate_links.py not found — skipping"
fi

# P30 boundary: pre-commit can record implementation/regression evidence,
# but it cannot issue terminal artifact acceptance.  Any local role, identity,
# materiality, or audit claim remains non-authoritative.
echo "[pre-commit] Running P30 regression boundary..."
if [ -f "$P30_STATE" ]; then
    py "$P30_STATE" --regression-evidence \
        --role "${SUA_ROLE:-UNSPECIFIED}" \
        --regression-status "REGRESSION PASS"
    echo "[pre-commit] P30: artifact acceptance not issued"
else
    echo "[pre-commit] p30_acceptance.py not found — blocking" >&2
    exit 1
fi

# Note: verify_after.py is intentionally NOT called from pre-commit
# because the commit hasn't happened yet.  Run it manually after
# commit (or in CI) per core-layer/governance-template.md.

exit 0
