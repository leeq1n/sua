#!/usr/bin/env bash
# commit-msg hook: enforce that commit message references at least one
# P-n (currently P1-P30) from agent-tools/hook_principles.json (single source of truth).
# Per AGENTS.md "Commit message contract" + decision doc Q2 closure.
#
# TEMPLATE — install with: cp hooks/commit-msg .git/hooks/commit-msg
#                    then: chmod +x .git/hooks/commit-msg
#
# This file is the TEMPLATE for .git/hooks/commit-msg (not auto-installed).
# Installed at .git/hooks/commit-msg (auto-run by git on every commit
# AFTER the user supplies a message but BEFORE the commit lands).
#
# This is a HARD constraint.  Per Moltbook 2026 (Zerhoudi et al.),
# hard constraints produce immediate behavioral shifts; soft guidance
# is ignored.  Without this hook, agents may commit without citing
# any principle, defeating PRINCIPLES.md's purpose.
#
# The hook receives $1 = path to the commit message file.  Unlike
# pre-commit, this file is GUARANTEED to contain the actual message
# the user just supplied.

set -e

# Windows: python (native exe) cannot open MSYS paths (/c/...).
# Convert script path via cygpath when running under git-for-windows.
py() {
    local script="$1"; shift
    if command -v cygpath >/dev/null 2>&1; then
        script="$(cygpath -w "$script")"
    fi
    python "$script" "$@"
}

COMMIT_MSG_FILE="${1:-}"
if [ -z "$COMMIT_MSG_FILE" ] || [ ! -f "$COMMIT_MSG_FILE" ]; then
    echo "ERROR: commit-msg hook called without a message file" >&2
    exit 1
fi

MSG=$(cat "$COMMIT_MSG_FILE")

# Get active P-n whitelist from registry (per Q2 closure - T3).
REPO_ROOT="$(git rev-parse --show-toplevel)"
LOADER="$REPO_ROOT/agent-tools/scripts/hook_principles_loader.py"

if [ ! -f "$LOADER" ]; then
    echo "ERROR: hook_principles_loader.py not found at $LOADER" >&2
    echo "  Per Q2 closure, principles registry is the single source of truth." >&2
    exit 2
fi

# Load active P-n list (whitelist excluding merged/demoted per registry)
ACTIVE_P_LIST="$(py "$LOADER" --active-list 2>/dev/null)"
if [ -z "$ACTIVE_P_LIST" ]; then
    echo "ERROR: failed to load active P-n list from registry" >&2
    exit 2
fi

# Build regex from active list (pipe-separated alternation)
P_REGEX="$(echo "$ACTIVE_P_LIST" | sed 's/ /|/g; s/^/(/; s/$/)/')"

# Check message for at least one P-n reference
if ! echo "$MSG" | grep -qE "$P_REGEX"; then
    cat >&2 <<EOF
ERROR: commit message must reference at least one P-n from registry.

  Per AGENTS.md 'Commit message contract' and docs/PRINCIPLES.md,
  every commit must cite the principle that motivated the change.

  Active P-n values (loaded from agent-tools/hook_principles.json):
    $ACTIVE_P_LIST

  Examples of valid messages:
    "docs: clarify interlock (P14, P17)"
    "feat(kg): add kg_arbiter (P9)"
    "chore: add AGENTS.md (P14, P17)"

  To skip this check (NOT recommended), pass --no-verify.
EOF
    exit 1
fi

exit 0
